{
  "expo": {
    "name": "The Simisium",
    "slug": "the-simisium",
    "version": "0.1.0",
    "scheme": "simisium",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0E14",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.milesware.simisium",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "The Simisium uses your location to seed the game world with nearby real places."
      }
    },
    "android": {
      "package": "io.milesware.simisium",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      ["expo-location", { "locationWhenInUsePermission": "Seed the world with real places near you." }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
